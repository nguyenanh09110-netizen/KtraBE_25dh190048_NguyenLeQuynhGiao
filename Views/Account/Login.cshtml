
@{
    ViewBag.Title = "Đăng Nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-5 mb-4">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0" style="border-radius: 16px; background-color: #f8fbff; border: 1px solid #d0e5ff;">
            <div class="card-body p-4">
                <h2>Đăng nhập</h2>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form method="post" action="@Url.Action("Login", "Account")" style="max-width: 400px;">
                    <div class="mb-3">
                        <label class="form-label">Tên đăng nhập</label>
                        <input type="text" name="username" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu</label>
                        <input type="password" name="password" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Đăng nhập</button>
                    <a href="@Url.Action("Register", "Account")" class="btn btn-link">Chưa có tài khoản? Đăng ký</a>
                </form>
            </div>
        </div>
    </div>
</div>
