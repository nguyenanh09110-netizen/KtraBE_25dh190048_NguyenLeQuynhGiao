@model IEnumerable<WebBH.Models.Order>

@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string[] tabs = { "Tất cả đơn", "Chờ xác nhận", "Đang xử lý", "Đang giao", "Đã giao", "Đã hủy" };
}

<h2>Đơn hàng của tôi</h2>
@if (ViewBag.HasAnyOrder == false)
{
    <div class="alert mt-3" style="background-color: #d9ecff; color: #1e3a5f; border-color: #b8daff;">
        <p class="fw-bold mb-2">BẠN CHƯA CÓ ĐƠN HÀNG NÀO. HÃY ĐẶT ĐƠN NGAY.</p>
        <a href="@Url.Action("Index", "Home")" class="btn btn-sm text-decoration-none" style="background-color: #1e3a5f; color: #ffffff;">Về trang chủ</a>
    </div>
}
else
{
    <ul class="nav nav-tabs mb-3">
        @foreach (var tab in tabs)
        {
            <li class="nav-item">
                <a class="nav-link text-decoration-none @(ViewBag.Status == tab ? "active fw-bold" : "")"
                   style="color: #1e3a5f;"
                   href="@Url.Action("MyOrder", "Account", new { status = tab, search = ViewBag.Search })">
                    @tab
                </a>
            </li>
        }
    </ul>

    <form method="get" action="@Url.Action("MyOrder", "Account")" class="d-flex gap-2 mb-3">
        <input type="hidden" name="status" value="@(ViewBag.Status ?? "")" />
        <input type="text" name="search" value="@(ViewBag.Search ?? "")" class="form-control" placeholder="Tìm theo Mã đơn hàng hoặc Tên sản phẩm..." />
        <button type="submit" class="btn btn-sm" style="background-color: #d9ecff; color: #1e3a5f; border-color: #b8daff;">Tìm đơn hàng</button>
    </form>

    if (!Model.Any())
    {
        <p class="text-muted">Không tìm thấy đơn hàng phù hợp.</p>
    }
    else
    {
        foreach (var order in Model)
        {
            <div class="card mb-3" style="border-color: #d0e5ff; border-radius: 12px;">
                <div class="card-header d-flex justify-content-between" style="background-color: #d9ecff; color: #1e3a5f;">
                    <span>
                        <strong>Đơn #@order.OrderID</strong>
                        - @order.OrderDate.ToString("dd/MM/yyyy")
                    </span>
                    <strong>@(order.OrderStatus ?? "Chờ xác nhận")</strong>
                </div>
                <div class="card-body">
                    @foreach (var detail in order.OrderDetails)
                    {
                        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                            <div style="color: #1e3a5f;">
                                <strong>@detail.Product.ProductName</strong> (x@detail.Quantity)
                            </div>
                            <div>
                                <a href="@Url.Action("Rebuy", "Account", new { productId = detail.ProductID })"
                                   class="btn btn-sm text-decoration-none"
                                   style="background-color: #d9ecff; color: #1e3a5f; border-color: #b8daff;">
                                    Mua lại
                                </a>
                                <a href="@Url.Action("Details", "Shop", new { id = detail.ProductID })"
                                   class="btn btn-sm text-decoration-none ms-1"
                                   style="background-color: #f0f7ff; color: #1e3a5f; border-color: #d0e5ff;">
                                    Xem chi tiết
                                </a>
                            </div>
                        </div>
                    }
                    <div class="text-end mt-2 fw-bold" style="color: #1e3a5f;">
                        Tổng tiền: @String.Format("{0:N0} đ", order.TotalAmount)
                    </div>
                </div>
            </div>
        }

        if (ViewBag.ShowMore != true)
        {
            <div class="text-center mb-4">
                <a href="@Url.Action("MyOrder", "Account", new { status = ViewBag.Status, search = ViewBag.Search, showMore = true })"
                   class="btn btn-sm text-decoration-none"
                   style="background-color: #d9ecff; color: #1e3a5f; border-color: #b8daff;">
                    Xem thêm
                </a>
            </div>
        }
    }
}