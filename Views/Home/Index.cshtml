
@{
    ViewBag.Title = "Cửa hàng";
}


<style>
    .hero-banner {
        background: linear-gradient(135deg, #e7f3ff 0%, #f4f9ff 100%);
        border: 1px solid #d0e5ff;
        border-radius: 16px;
        padding: 45px 40px;
        margin-top: 20px;
        margin-bottom: 40px;
    }

    .hero-img {
        width: 100%;
        max-height: 320px;
        object-fit: cover;
        border-radius: 12px;
    }

    .btn-pastel {
        background-color: #4a90e2;
        border-color: #4a90e2;
        color: #fff;
        font-weight: 500;
    }

        .btn-pastel:hover {
            background-color: #357abd;
            border-color: #357abd;
            color: #fff;
        }

    .btn-outline-pastel {
        border-color: #4a90e2;
        color: #357abd;
    }

        .btn-outline-pastel:hover {
            background-color: #e7f3ff;
            color: #2b6cb0;
        }

    .cat-card {
        border: 1px solid #e6f0fa;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(74, 144, 226, 0.08);
        transition: transform 0.2s ease;
    }

        .cat-card:hover {
            transform: translateY(-5px);
        }

        .cat-card img {
            height: 220px;
            object-fit: cover;
            width: 100%;
        }

    .policy-box {
        background-color: #f2f8ff;
        border: 1px solid #dcebff;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        margin-top: 40px;
    }
</style>

<!-- 1. Banner chính -->
<div class="hero-banner">
    <div class="row align-items-center">
        <div class="col-md-6">
            <span class="badge mb-2" style="background-color: #b8daff; color: #1d4ed8;">BỘ SƯU TẬP MỚI 2026</span>
            <h1 class="display-5 fw-bold mb-3" style="color: #1e3a5f;">CỬA HÀNG THỜI TRANG</h1>
            <p class="lead text-muted mb-4">
                Phong cách tối giản, trẻ trung và dễ phối mỗi ngày. Khám phá ngay các mẫu áo thun, quần jean và phụ kiện da mới nhất.
            </p>
            <a href="@Url.Action("Index", "Shop")" class="btn btn-pastel btn-lg px-4">
                Mua sắm ngay &rarr;
            </a>
        </div>
        <div class="col-md-6 mt-4 mt-md-0 text-center">
            <img src="@Url.Content("~/Image/banner.jpg")" alt="Thời trang WebBH" class="hero-img" />
        </div>
    </div>
</div>

<!-- 2. Danh mục nổi bật -->
<h3 class="fw-bold mb-3 text-center" style="color: #1e3a5f;">Danh mục nổi bật</h3>
<div class="row g-4">
    <div class="col-md-4">
        <div class="card cat-card h-100">
            <img src="@Url.Content("~/Image/ao_thun.jpg")" alt="Áo thun" />
            <div class="card-body text-center">
                <h5 class="card-title fw-bold" style="color: #1e3a5f;">Áo thun</h5>
                <p class="card-text text-muted small">Form rộng thoáng mát, chất cotton thấm hút tốt.</p>
                <a href="@Url.Action("Index", "Shop")" class="btn btn-outline-pastel btn-sm">Xem mẫu</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card cat-card h-100">
            <img src="@Url.Content("~/Image/quan_jean.jpg")" alt="Quần Jean" />
            <div class="card-body text-center">
                <h5 class="card-title fw-bold" style="color: #1e3a5f;">Quần Jean</h5>
                <p class="card-text text-muted small">Dáng chuẩn hiện đại, bền màu, dễ phối đồ.</p>
                <a href="@Url.Action("Index", "Shop")" class="btn btn-outline-pastel btn-sm">Xem mẫu</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card cat-card h-100">
            <img src="@Url.Content("~/Image/vi_da.jpg")" alt="Ví da" />
            <div class="card-body text-center">
                <h5 class="card-title fw-bold" style="color: #1e3a5f;">Ví da</h5>
                <p class="card-text text-muted small">Thiết kế gọn gàng, lịch lãm, bền đẹp theo thời gian.</p>
                <a href="@Url.Action("Index", "Shop")" class="btn btn-outline-pastel btn-sm">Xem mẫu</a>
            </div>
        </div>
    </div>
</div>

<!-- 3. Thanh cam kết cuối trang -->
<div class="policy-box">
    <div class="row">
        <div class="col-md-4 mb-2 mb-md-0">
            <h6 class="fw-bold mb-1" style="color: #1e3a5f;">Giao hàng nhanh chóng</h6>
            <small class="text-muted">Giao tận nơi trên toàn quốc</small>
        </div>
        <div class="col-md-4 mb-2 mb-md-0">
            <h6 class="fw-bold mb-1" style="color: #1e3a5f;">Chất liệu tuyển chọn</h6>
            <small class="text-muted">Đảm bảo form dáng và độ bền đẹp</small>
        </div>
        <div class="col-md-4">
            <h6 class="fw-bold mb-1" style="color: #1e3a5f;">Hỗ trợ đổi trả</h6>
            <small class="text-muted">Dễ dàng đổi size trong 7 ngày</small>
        </div>
    </div>
</div>