@model WebBH.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<<h2>Chi tiết đơn hàng</h2>

<div class="row">
    <div class="col-md-4">
        <h5>THÔNG TIN ĐƠN HÀNG</h5>
        <p><strong>Mã đơn:</strong> #@Model.OrderID</p>
        <p><strong>Ngày đặt hàng:</strong> @Model.OrderDate.ToString("dd/MM/yyyy")</p>
        <p><strong>Tên khách hàng:</strong> @Model.Customer.CustomerName</p>
        <p><strong>Tổng giá trị:</strong> @String.Format("{0:N0} VNĐ", Model.TotalAmount)</p>
        <p><strong>Trạng thái thanh toán:</strong> @Model.PaymentStatus</p>
        <p><strong>Trạng thái đơn hàng:</strong> @Model.OrderStatus</p>
    </div>

    <div class="col-md-8">
        <table class="table table-bordered">
            <tr>
                <th>Sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
            @foreach (var item in Model.OrderDetails)
            {
                <tr>
                    <td>@item.Product.ProductName</td>
                    <td>@item.Quantity</td>
                    <td>@String.Format("{0:N0}", item.UnitPrice)</td>
                    <td>@String.Format("{0:N0}", item.Quantity * item.UnitPrice)</td>
                </tr>
            }
        </table>
    </div>
</div>

<div class="mt-3">
    <a href="@Url.Action("UpdateStatus", "Orders", new { id = Model.OrderID })" class="btn btn-primary">
        Cập nhật trạng thái
    </a>
    <a href="@Url.Action("Index", "Orders")" class="btn btn-secondary ms-1">
        Quay lại danh sách
    </a>
</div>


