
@model WebBH.Models.Order
@{
    ViewBag.Title = "Chi tiết đơn hàng";
}

<h2>Chi tiết đơn hàng #@Model.OrderID</h2>

<p><strong>Khách hàng:</strong> @(Model.Customer != null ? Model.Customer.CustomerName : "")</p>
<p><strong>Số điện thoại:</strong> @(Model.Customer != null ? Model.Customer.CustomerPhone : "")</p>
<p><strong>Địa chỉ giao hàng:</strong> @Model.AddressDelivery</p>
<p><strong>Ngày đặt:</strong> @Model.OrderDate</p>
<p><strong>Tổng tiền:</strong> @Model.TotalAmount.ToString("N0") đ</p>
<p><strong>Trạng thái hiện tại:</strong> @Model.PaymentStatus</p>

<form method="post" action="@Url.Action("UpdateStatus", "Orders")" class="mb-4 d-flex gap-2">
    <input type="hidden" name="orderId" value="@Model.OrderID" />
    <select name="paymentStatus" class="form-select" style="width: 220px;">
        <option value="Chờ xác nhận" @(Model.PaymentStatus == "Chờ xác nhận" ? "selected" : "")>Chờ xác nhận</option>
        <option value="Đang giao" @(Model.PaymentStatus == "Đang giao" ? "selected" : "")>Đang giao</option>
        <option value="Đã giao" @(Model.PaymentStatus == "Đã giao" ? "selected" : "")>Đã giao</option>
        <option value="Đã hủy" @(Model.PaymentStatus == "Đã hủy" ? "selected" : "")>Đã hủy</option>
    </select>
    <button type="submit" class="btn btn-success">Cập nhật trạng thái</button>
</form>

<h4>Danh sách sản phẩm trong đơn</h4>
<table class="table table-bordered">
    <tr>
        <th>Sản phẩm</th>
        <th>Số lượng</th>
        <th>Đơn giá</th>
        <th>Thành tiền</th>
    </tr>
    @foreach (var d in Model.OrderDetails)
    {
        <tr>
            <td>@(d.Product != null ? d.Product.ProductName : ("SP #" + d.ProductID))</td>
            <td>@d.Quantity</td>
            <td>@d.UnitPrice.ToString("N0") đ</td>
            <td>@((d.Quantity * d.UnitPrice).ToString("N0")) đ</td>
        </tr>
    }
</table>

<a href="@Url.Action("Index", "Orders")" class="btn btn-secondary">Quay lại danh sách</a>
