@model WebBH.Models.Product

@{
    ViewBag.Title = "Chi tiết sản phẩm";
}

<h2 class="mb-4" style="color: #1e3a5f;">Chi tiết sản phẩm</h2>

<div class="card shadow-sm" style="border-radius: 14px; border-color: #d0e5ff;">
    <div class="card-body p-4">
        <div class="row align-items-center">
            <div class="col-md-4 text-center mb-3 mb-md-0">
                @if (!string.IsNullOrEmpty(Model.ProductImage))
                {
                    <img src="@Url.Content("~/Image/" + Model.ProductImage)" alt="@Model.ProductName" class="img-fluid rounded border" style="max-height: 260px; object-fit: cover;" />
                }
                else
                {
                    <div class="p-5 bg-light text-muted rounded border">Chưa có ảnh</div>
                }
            </div>

            <div class="col-md-8">
                <dl class="row mb-0">
                    <dt class="col-sm-4" style="color: #1e3a5f;">Tên sản phẩm</dt>
                    <dd class="col-sm-8">@Model.ProductName</dd>

                    <dt class="col-sm-4" style="color: #1e3a5f;">Đơn giá</dt>
                    <dd class="col-sm-8">@Model.ProductPrice.ToString("N0") VNĐ</dd>

                    <dt class="col-sm-4" style="color: #1e3a5f;">Số lượng tồn</dt>
                    <dd class="col-sm-8">@Model.Quantity</dd>

                    <dt class="col-sm-4" style="color: #1e3a5f;">Chủng loại</dt>
                    <dd class="col-sm-8">@(Model.Category != null ? Model.Category.CategoryName : "")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a href="@Url.Action("Edit", "Products", new { id = Model.ProductID })" class="btn btn-outline-primary btn-sm text-decoration-none">
        Sửa
    </a>
    <a href="@Url.Action("Index", "Products")" class="btn btn-outline-secondary btn-sm text-decoration-none ms-1">
        Quay lại danh sách
    </a>
</div>
