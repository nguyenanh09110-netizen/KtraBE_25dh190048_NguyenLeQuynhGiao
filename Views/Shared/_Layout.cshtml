<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Cửa hàng</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light shadow-sm" style="background-color: #d9ecff;">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center" style="color: #1e3a5f;" href="@Url.Action("Index", "Home")">
                <img src="@Url.Content("~/Image/logo.png")" alt="Logo" height="50" class="me-2" />
                <span>WebBH</span>
            </a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link" style="color: #1e3a5f;" href="@Url.Action("Index", "Shop")">Mua sắm</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" style="color: #1e3a5f;" href="@Url.Action("Cart", "Shop")">Giỏ hàng</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" style="color: #1e3a5f;" href="@Url.Action("MyOrder", "Account")">Lịch sử mua hàng</a>
                    </li>
                    @if (Session["Role"] != null && Session["Role"].ToString().Trim() == "A")
                    {
                        <li class="nav-item">
                            <a class="nav-link" style="color: #1e3a5f;" href="@Url.Action("Index", "Categories")">Danh mục</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" style="color: #1e3a5f;" href="@Url.Action("Index", "Products")">Sản phẩm</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" style="color: #1e3a5f;" href="@Url.Action("Index", "Orders")">Đơn hàng</a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav">
                    @if (Session["Username"] == null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" style="color: #1e3a5f;" href="@Url.Action("Login", "Account")">Đăng nhập</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" style="color: #1e3a5f;" href="@Url.Action("Register", "Account")">Đăng ký</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <span class="nav-link" style="color: #1e3a5f;">Xin chào, <b>@Session["Username"]</b></span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger" href="@Url.Action("Logout", "Account")">Đăng xuất</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - WebBH</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>