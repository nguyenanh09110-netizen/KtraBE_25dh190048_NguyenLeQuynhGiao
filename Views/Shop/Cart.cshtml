@model List<WebBH.Controllers.CartItem>
@{
    ViewBag.Title = "Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal totalAmount = ViewBag.TotalAmount != null ? (decimal)ViewBag.TotalAmount : 0;
}

<h2>Giỏ hàng của bạn</h2>

@if (Model == null || !Model.Any())
{
    <p>Giỏ hàng đang trống.</p>
    <a href="@Url.Action("Index", "Shop")" class="btn btn-outline-primary btn-sm text-decoration-none" style="background-color: #d9ecff; color: #1e3a5f; border-color: #b8daff;">Đi mua sắm</a>
}
else
{
    <table class="table table-bordered">
        <tr>
            <th>Sản phẩm</th>
            <th>Đơn giá</th>
            <th>Số lượng</th>
            <th>Thành tiền</th>
            <th>Xóa</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.UnitPrice.ToString("N0") đ</td>
                <td>
                    <form method="post" action="@Url.Action("UpdateCart", "Shop")" style="display:inline;">
                        <input type="hidden" name="productId" value="@item.ProductID" />
                        <input type="number" name="quantity" value="@item.Quantity" min="0" style="width:70px;" />
                        <button type="submit">Cập nhật</button>
                    </form>
                </td>
                <td>@item.TotalPrice.ToString("N0") đ</td>
                <td><a href="@Url.Action("RemoveFromCart", "Shop", new { id = item.ProductID })">Xóa</a></td>
            </tr>
        }
    </table>

    <p><strong>Tổng tiền: @totalAmount.ToString("N0") đ</strong></p>
    <p>
        <a href="@Url.Action("Index", "Shop")">Mua thêm</a> |
        <a href="@Url.Action("Checkout", "Shop")"><strong>Tiến hành đặt hàng</strong></a>
    </p>
}

