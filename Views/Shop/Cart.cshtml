@model List<WebBH.Controllers.CartItem>
@{
    ViewBag.Title = "Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal totalAmount = ViewBag.TotalAmount != null ? (decimal)ViewBag.TotalAmount : 0;
}

<div class="container py-3" style="max-width: 960px;">
    <h2 class="mb-3" style="color: #1e3a5f;">Giỏ hàng của bạn</h2>

    @if (Model == null || !Model.Any())
    {
        <p>Giỏ hàng đang trống.</p>
        <a href="@Url.Action("Index", "Shop")" class="btn btn-outline-primary btn-sm text-decoration-none" style="background-color: #d9ecff; color: #1e3a5f; border-color: #b8daff;">Đi mua sắm</a>
    }
    else
    {
        <table class="table table-bordered">
            <tr>
                <th>Sản phẩm</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
                <th>Xóa</th>
            </tr>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.UnitPrice.ToString("N0") đ</td>
                    <td>
                        <form method="post" action="@Url.Action("UpdateCart", "Shop")" style="display:inline;">
                            <input type="hidden" name="productId" value="@item.ProductID" />
                            <input type="number" name="quantity" value="@item.Quantity" min="0" style="width:70px;" />
                            <button type="submit" class="btn btn-sm text-decoration-none" style="background-color: #d9ecff; color: #1e3a5f; border-color: #b8daff;">
                                Cập nhật
                            </button>
                        </form>
                    </td>
                    <td>@item.TotalPrice.ToString("N0") đ</td>
                    <td>
                        <a href="@Url.Action("RemoveFromCart", "Shop", new { id = item.ProductID })"
                           class="btn btn-sm text-decoration-none"
                           style="background-color: #ffe5e5; color: #8b1e1e; border-color: #f5c2c2;">
                            Xóa
                        </a>
                    </td>
                </tr>
            }
        </table>

        <p><strong>Tổng tiền: @totalAmount.ToString("N0") đ</strong></p>
        <p>
            <a href="@Url.Action("Index", "Shop")"
            class="btn btn-sm text-decoration-none px-3 py-2"
           style="background-color: #f0f7ff; color: #1e3a5f; border-color: #b8daff;">
            Mua thêm
            </a>
            <a href="@Url.Action("Checkout", "Shop")"
               class="btn btn-sm text-decoration-none px-3 py-2 fw-semibold"
               style="background-color: #1e3a5f; color: #ffffff; border-color: #1e3a5f;">
                Tiến hành đặt hàng
            </a>
        </p>
    }

</div>