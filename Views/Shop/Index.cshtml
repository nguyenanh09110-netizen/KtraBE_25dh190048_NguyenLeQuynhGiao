@model IEnumerable<WebBH.Models.Product>

@{
    ViewBag.Title = "Cửa hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categories = ViewBag.Categories as List<WebBH.Models.Category>;
}

<h2>Danh sách sản phẩm</h2>

<form method="get" action="@Url.Action("Index", "Shop")" style="margin-bottom: 15px;">
    <input type="text" name="search" value="@Request["search"]" placeholder="Tìm tên sản phẩm..." />
    <select name="categoryId">
        <option value="">-- Tất cả danh mục --</option>
        @if (categories != null)
        {
            foreach (var c in categories)
            {
                <option value="@c.CategoryID" @(Request["categoryId"] == c.CategoryID.ToString() ? "selected" : "")>
                    @c.CategoryName
                </option>
            }
        }
    </select>
    <button type="submit">Lọc</button>
    <a href="@Url.Action("Cart", "Shop")" class="btn btn-outline-primary btn-sm text-decoration-none ms-2" style="background-color: #d9ecff; color: #1e3a5f; border-color: #b8daff;">Xem giỏ hàng</a>
</form>

<table class="table table-bordered">
    <tr>
        <th>Ảnh</th>
        <th>Tên sản phẩm</th>
        <th>Danh mục</th>
        <th>Giá</th>
        <th>Còn lại</th>
        <th>Thao tác</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                @if (!string.IsNullOrEmpty(item.ProductImage))
                {
                    <img src="@Url.Content("~/Image/" + item.ProductImage)" width="70" />
                }
            </td>
            <td>@item.ProductName</td>
            <td>@(item.Category != null ? item.Category.CategoryName : "")</td>
            <td>@item.ProductPrice.ToString("N0") đ</td>
            <td>@item.Quantity</td>
            <td>
                <a href="@Url.Action("Details", "Shop", new { id = item.ProductID })" class="btn btn-outline-secondary btn-sm text-decoration-none" style="background-color: #d9ecff; color: #1e3a5f; border-color: #b8daff;">Chi tiết</a>
                <a href="@Url.Action("AddToCart", "Shop", new { id = item.ProductID, qty = 1 })" class="btn btn-primary btn-sm text-decoration-none ms-1" style="background-color: #d9ecff; color: #1e3a5f; border-color: #b8daff;">Thêm vào giỏ</a>
            </td>
        </tr>
    }
</table>
